# FrogLabs — cache e compressão (LiteSpeed/Apache)
# Atenção: as pastas dos subdomínios ficam dentro desta public_html e herdam estas regras.
# Por isso o index.php continua na lista, e nada aqui mexe em PHP ou em rotas.
DirectoryIndex index.html index.php

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
